# ==================================================
# Sécurité générale
# ==================================================
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ==================================================
    # Protection fichiers sensibles
    # ==================================================

    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^config/ - [F,L]
    RewriteRule ^data/ - [F,L]

    RewriteRule ^composer\.json$ - [F,L]
    RewriteRule ^composer\.lock$ - [F,L]

    # ==================================================
    # Redirections héritées
    # ==================================================

    RewriteRule ^index\.php$ / [R=301,L]

    RewriteRule ^admin/index\.php$ /admin [R=301,L]

    RewriteRule ^flush\.php$ /api/flush.php [R=301,L]

    # ==================================================
    # Laisser passer les ressources existantes
    # ==================================================

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ==================================================
    # Routage API
    # ==================================================

    RewriteRule ^api/(.*)$ /api/index.php?path=$1 [QSA,L]

    # ==================================================
    # Routage principal
    # ==================================================

    RewriteRule ^(.*)$ /api/index.php?path=$1 [QSA,L]

</IfModule>

# ==================================================
# Headers de sécurité
# ==================================================

<IfModule mod_headers.c>

    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"

    # Obsolète mais sans impact négatif majeur
    Header always unset X-XSS-Protection

    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # À conserver uniquement si tout le site est en HTTPS
    Header always set Strict-Transport-Security "max-age=31536000"

</IfModule>

# ==================================================
# Compression
# ==================================================

<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json

</IfModule>

# ==================================================
# Cache ressources statiques
# ==================================================

<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|css|js|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

# ==================================================
# Pas de cache PHP
# ==================================================

<FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
</FilesMatch>
