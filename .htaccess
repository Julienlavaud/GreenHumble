Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    #################################################
    # Protection des fichiers sensibles
    #################################################

    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^composer\.json$ - [F,L]
    RewriteRule ^composer\.lock$ - [F,L]

    # Anciennes URLs /admin/* -> URL canonique /api/admin/* (301)
    RewriteRule ^admin/?$ /api/admin/index.php [R=301,L]
    RewriteCond %{DOCUMENT_ROOT}/api/admin/$1 -f
    RewriteRule ^admin/(.+)$ /api/admin/$1 [R=301,L]
    RewriteCond %{DOCUMENT_ROOT}/api/$1 -f
    RewriteRule ^admin/(.+)$ /api/$1 [R=301,L]
    RewriteRule ^admin/.*$ /api/admin/index.php [R=301,L]

    #################################################
    # Laisser passer les fichiers et dossiers réels
    #################################################

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    #################################################
    # Redirections historiques
    #################################################

    RewriteRule ^index\.php$ / [R=301,L]
    RewriteRule ^flush\.php$ /flush [R=301,L]

    #################################################
    # Routage global
    #################################################

    RewriteRule ^.*$ /api/router.php [QSA,L]

</IfModule>

#################################################
# Headers sécurité
#################################################

<IfModule mod_headers.c>

    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # À garder uniquement en HTTPS partout
    Header always set Strict-Transport-Security "max-age=31536000"

</IfModule>

#################################################
# Compression
#################################################

<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json

</IfModule>

#################################################
# Cache assets
#################################################

<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|css|js|woff|woff2)$">
    Header always set Cache-Control "public,max-age=2592000"
</FilesMatch>

#################################################
# Pas de cache PHP
#################################################

<FilesMatch "\.php$">
    Header always set Cache-Control "no-store,no-cache,must-revalidate,max-age=0"
</FilesMatch>
