# =====================================================================
# CONFIGURATION NGINX - CLIMAT LOCAL (PHP-FPM)
# Compatible : Serveurs Dédiés, VPS, Cloud Run, o2switch Nginx
# =====================================================================

server {
    listen 80;
    listen [::]:80;
    server_name votre-domaine.com www.votre-domaine.com;
    root /var/www/climatlocal;
    index index.html index.php;

    charset utf-8;

    # Sécurité : Bloquer les fichiers cachés, .env, .git, SQL
    location ~ /\.(env|git|htaccess) {
        deny all;
        return 404;
    }

    location ~ /(logs|backups|config)/ {
        deny all;
        return 404;
    }

    location ~ \.(sql|lock)$ {
        deny all;
        return 404;
    }

    # En-têtes de sécurité
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Frontend Single Page Application
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API & Scripts PHP
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock; # ou 127.0.0.1:9000
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    # Compression Gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;
}
