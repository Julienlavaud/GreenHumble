{
  "script_deploiement_automatique": {
    "titre": "Script & Orchestrateur de Déploiement Automatique GreenHumble",
    "version": "3.5.0",
    "identite": "GreenHumble / Cabinet Climat Local (climatlocal.com)",
    "devise": "Le climat, ensemble.",
    "type_execution": "AUTOMATED_CI_CD_ORCHESTRATOR",
    "pipeline_execution": [
      {
        "phase": 1,
        "nom": "Contrôle d'Environnement Serveur & Extensions PHP",
        "commandes_cli": [
          "php -v",
          "php -m | grep -E 'pdo_mysql|curl|mbstring|json|openssl|gd|zip'"
        ],
        "criteres_succes": {
          "php_version": ">= 8.2.0",
          "extensions_obligatoires": ["pdo_mysql", "curl", "mbstring", "json", "openssl", "gd", "zip"],
          "memory_limit": ">= 256M",
          "max_execution_time": ">= 60s"
        },
        "action_si_echec": "ABORT_DEPLOYMENT_ENVIRONMENT_INCOMPATIBLE"
      },
      {
        "phase": 2,
        "nom": "Validation des Secrets & Clés API (.env)",
        "commandes_cli": [
          "test -f /config/.env || cp /config/.env.example /config/.env",
          "chmod 600 /config/.env"
        ],
        "verifications_cles": [
          { "cle": "GEMINI_API_KEY", "statut": "REQUIS", "test_ping": "https://generativelanguage.googleapis.com/v1beta/models" },
          { "cle": "GROQ_API_KEY", "statut": "REQUIS", "test_ping": "https://api.groq.com/openai/v1/models" },
          { "cle": "JWT_SECRET", "statut": "REQUIS", "longueur_min": 64 }
        ],
        "action_si_echec": "ABORT_DEPLOYMENT_MISSING_API_KEYS"
      },
      {
        "phase": 3,
        "nom": "Synchronisation des Tables SQL & Migrations Automatiques",
        "commandes_cli": [
          "php /api/admin/console.php --migrate-database",
          "mysql -u$DB_USER -p$DB_PASS $DB_NAME < /schema.sql"
        ],
        "tables_synchronisees": [
          "cl_ai_settings",
          "cl_ai_prompts",
          "cl_ai_dictionaries",
          "cl_ai_rules",
          "cl_ai_opportunities",
          "cl_users",
          "cl_teams",
          "cl_roles",
          "cl_permissions",
          "cl_sessions"
        ],
        "strategie_migration": "TRANSACTION_ACID_WITH_ROLLBACK_ON_ERROR",
        "action_si_echec": "ROLLBACK_PREVIOUS_SQL_SNAPSHOT"
      },
      {
        "phase": 4,
        "nom": "Mise à Jour du Code Backend & Déploiement des Fichiers",
        "commandes_cli": [
          "rsync -avz --exclude='.env' --exclude='/data/backups' /release/ /var/www/greenhumble/",
          "chmod -R 755 /var/www/greenhumble/api/",
          "chmod -R 770 /var/www/greenhumble/data/backups/"
        ],
        "fichiers_critiques_mis_a_jour": [
          "/api/router.php",
          "/api/controllers/AuditController.php",
          "/api/controllers/ProspecController.php",
          "/api/controllers/ConfigController.php",
          "/api/services/AiEngineService.php",
          "/api/services/ScoringService.php"
        ]
      },
      {
        "phase": 5,
        "nom": "Purge du Cache & Redémarrage des Services",
        "commandes_cli": [
          "php -r 'opcache_reset();' || true",
          "rm -rf /var/www/greenhumble/tmp/cache/* || true",
          "systemctl reload php8.2-fpm || systemctl reload apache2 || systemctl reload nginx"
        ],
        "verifications_post_redemarrage": {
          "opcache_clean": true,
          "http_status_ping": 200
        }
      },
      {
        "phase": 6,
        "nom": "Recette Automatisée Post-Déploiement (Smoke Tests)",
        "tests_executes": [
          {
            "nom": "Test Authentification & Session",
            "endpoint": "POST /api/admin/auth/login",
            "statut_attendu": 200
          },
          {
            "nom": "Test Audit Sémantique & Scoring Green Claims",
            "endpoint": "POST /api/audit",
            "payload_test": { "url": "https://climatlocal.com" },
            "statut_attendu": 200,
            "validation_ia": "gemini-3.8-flash OU groq fallback résolu"
          },
          {
            "nom": "Test Détection Prospection B2B",
            "endpoint": "POST /api/prospec",
            "payload_test": { "entreprise": "Test Bio Entreprise", "secteur": "Agroalimentaire" },
            "statut_attendu": 201
          },
          {
            "nom": "Test Création Sauvegarde Système",
            "endpoint": "POST /api/admin/backup/create",
            "statut_attendu": 201
          }
        ]
      }
    ],
    "structure_rapport_deploiement": {
      "format_succes": {
        "success": true,
        "status": 200,
        "deploiement_id": "dep_20261002_041205",
        "timestamp": "2026-10-02T04:12:05Z",
        "version_deployee": "3.5.0",
        "environnement": "production",
        "duree_totale_secondes": 14.8,
        "resume_etapes": {
          "environnement_php": "PASSED (PHP 8.2.18, 7 extensions)",
          "secrets_et_cles": "PASSED (Gemini & Groq validés)",
          "base_de_donnees": "PASSED (10 tables synchronisées)",
          "mise_a_jour_fichiers": "PASSED (Zéro collision)",
          "purge_cache": "PASSED (OPcache vidé)",
          "smoke_tests_api": "PASSED (4/4 endpoints OK)"
        },
        "telemetrie_moteur_ia": {
          "modele_primaire": "gemini-3.8-flash (résolu depuis *-last)",
          "latence_moyenne_ms": 482,
          "statut_fallback_groq": "OPERATIONNEL_EN_VEILLE"
        },
        "statut_global": "DEPLOIEMENT_SUCCES_PRODUCTION_ACTIVE"
      },
      "format_echec_et_rollback": {
        "success": false,
        "status": 500,
        "deploiement_id": "dep_failed_snapshot",
        "timestamp": "ISO_8601_UTC",
        "etape_en_erreur": "string",
        "erreur_detail": "string",
        "action_rollback": "Restauration automatique du code et du snapshot SQL antérieur exécutée avec succès.",
        "statut_global": "DEPLOIEMENT_ANNULE_ETAT_ANTERIEUR_PRESERVE"
      }
    }
  }
}
