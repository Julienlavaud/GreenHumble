    "validation_dynamique_parametres_ia": {
      "regles": {
        "provider": { "type": "string", "enum": ["gemini", "groq"], "requis": false },
        "model": { "type": "string", "requis": false, "validation": "Doit exister dans le catalogue dynamique" },
        "temperature": { "type": "float", "min": 0.0, "max": 1.0, "default": 0.25 },
        "max_tokens": { "type": "integer", "min": 128, "max": 8192, "default": 4096 },
        "json_mode": { "type": "boolean", "valeur_forcee": true }
      }
    },
    "normalisation_dynamique_reponses_ia": {
      "actions": [
        "1. Nettoyage Regex : extraction du contenu délimité entre ```json et ``` ou première accolade '{' et dernière '}'",
        "2. Réparation syntaxique : suppression des virgules trainantes (trailing commas) avant les accolades et crochets fermants",
        "3. Contrôle de validité : json_decode() avec JSON_THROW_ON_ERROR ; si échec, tentative de conversion des quotes",
        "4. Clamping des valeurs : scores ramenés strictement entre 0 et 100",
        "5. Injection du bloc 'ai_telemetry' contenant le modèle réel sollicité, l'éventuel basculement de fallback, la durée exacte en millisecondes et la volumétrie token"
      ]
    },
    "structure_json_entree_unifiee": {
      "description": "Payload standardisé préparé par l'orchestrateur avant envoi au provider",
      "schema": {
        "system_instruction": "string (consignes métier et juriste ESG)",
        "prompt_user": "string (données cibles à analyser)",
        "json_schema_attendu": "object (définition de la structure JSON cible)",
        "inference_config": {
          "temperature": 0.25,
          "max_output_tokens": 4096,
          "response_mime_type": "application/json"
        }
      }
    },
    "structure_json_sortie_unifiee": {
      "description": "Structure enveloppe retournée par l'orchestrateur à tout contrôleur backend",
      "schema": {
        "success": true,
        "status": 200,
        "data": "object (résultat métier normalisé)",
        "ai_telemetry": {
          "provider_sollicite": "string",
          "provider_effectif": "string",
          "modele_sollicite": "string",
          "modele_effectif": "string",
          "fallback_active": "boolean",
          "duree_ms": "integer",
          "tokens_entree": "integer",
          "tokens_sortie": "integer"
        },
        "timestamp": "string (ISO 8601 UTC)"
      }
