    "gestion_versions_last": {
      "principe": "Les variantes terminées par '-last' permettent d'appeler de manière pérenne la version de production la plus récente sans rupture de code lors des montées de version des fournisseurs.",
      "mecanisme_resolution": "Lors de l'appel, la méthode resolveModelAlias($modelId) interroge le registre en mémoire. Si $is_last_alias est vrai, l'orchestrateur remplace dynamiquement l'alias par l'identifiant technique cible fourni par l'API provider (ex: 'gemini-1.5-flash-last' devient 'gemini-1.5-flash-002')."
    },
    "ajout_automatique_futurs_modeles": {
      "frequence_scrutation": "Tâche cron exécutée toutes les 60 minutes via /api/cron/sync_ai_models.php",
      "processus": [
        "1. Interrogation asynchrone des endpoints de découverte de Google Gemini (/v1beta/models) et Groq (/openai/v1/models)",
        "2. Filtrage des modèles supportant la génération structurée JSON (json_mode ou response_format: { type: 'json_object' })",
        "3. Détection des nouveaux identifiants absents de cl_ai_settings",
        "4. Insertion automatique dans cl_ai_settings sous la catégorie 'variables_ia' avec le statut 'DISCOVERED' et notification dans les logs d'audit",
        "5. Mise à jour instantanée du cache applicatif APCu/Redis sans interruption de service"
      ]
    },
    "selection_dynamique_provider_et_modele": {
      "arbre_decision": [
        "Niveau 1 : Présence de 'preferred_provider' et 'preferred_model' dans le corps JSON de la requête entrante.",
        "Niveau 2 : Si omis, lecture de la configuration active dans cl_ai_settings (variable 'aiProvider' valant 'gemini' ou 'groq').",
        "Niveau 3 : Lecture du modèle par défaut associé à la tâche ('prompt_audit_anti_greenwashing' ou 'prompt_prospection_rse').",
        "Niveau 4 : Vérification de la disponibilité du provider (taux d'erreur récent et respect des quotas). Si indisponible, bascule proactive."
      ]
    },
