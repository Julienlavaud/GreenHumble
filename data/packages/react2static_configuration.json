{
  "react2static_greenhumble": {
    "manifeste": {
      "titre": "Adaptation & Pipeline Statique React2Static — GreenHumble v1.0",
      "version": "1.0.0",
      "slogan": "Le climat, ensemble.",
      "affiliation": "Cabinet Climat Local (climatlocal.com)",
      "statut": "OPERATIONNEL_PRODUCTION"
    },
    "configuration": {
      "base_path": "./",
      "dossier_sortie": "/dist",
      "bridge_php": "/api/includes/react_static_bridge.php",
      "manifest_statique": "/dist/react2static-manifest.json",
      "scripts_npm": {
        "build_static": "npm run build:static",
        "react2static": "npm run react2static"
      }
    },
    "utilisation_php": {
      "inclusion_code": "require_once __DIR__ . '/api/includes/react_static_bridge.php';\necho render_greenhumble_react_app();",
      "avantages": [
        "Fichiers HTML/CSS/JS 100% statiques et autonomes",
        "Chemins relatifs compatibles avec tout sous-dossier OVH (/www, /www/admin, /www/app)",
        "Versionnage automatique ?v=timestamp anti-cache",
        "Zéro dépendance Node.js requise sur le serveur de production"
      ]
    }
  }
}
