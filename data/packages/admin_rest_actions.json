    "POST_config": {
      "action_id": "POST_config",
      "endpoint": "/api/admin/config",
      "method": "POST",
      "description": "Ajoute un nouvel enregistrement de configuration ou dictionnaire",
      "parametres_attendus": {
        "headers": {
          "Content-Type": { "type": "string", "required": true, "default": "application/json" }
        },
        "body": {
          "nom": { "type": "string", "required": true, "description": "Clé technique unique" },
          "description": { "type": "string", "required": true, "description": "Descriptif de la variable" },
          "categorie": { "type": "string", "required": true, "description": "Catégorie fonctionnelle" },
          "valeur": { "type": "string", "required": true, "description": "Valeur chaîne ou JSON encodé" },
          "modifiable": { "type": "boolean", "default": true },
          "exportable": { "type": "boolean", "default": true },
          "importable": { "type": "boolean", "default": true },
          "supprimable": { "type": "boolean", "default": true }
        }
      },
      "schema_entree": {
        "type": "object",
        "required": ["nom", "description", "categorie", "valeur"],
        "properties": {
          "id": { "type": "string" },
          "nom": { "type": "string" },
          "description": { "type": "string" },
          "categorie": { "type": "string" },
          "valeur": { "type": "string" },
          "modifiable": { "type": "boolean" },
          "exportable": { "type": "boolean" },
          "importable": { "type": "boolean" },
          "supprimable": { "type": "boolean" }
        }
      },
      "schema_sortie": {
        "type": "object",
        "required": ["success", "message", "item"],
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "item": { "type": "object" }
        }
      },
      "mock_response": {
        "success": true,
        "message": "Élément de configuration ajouté avec succès",
        "item": {
          "id": "cfg_banned_terms_plastic",
          "nom": "termes_plastique_interdits",
          "description": "Allégations de biodégradabilité interdites par la loi AGEC",
          "categorie": "dictionnaires",
          "valeur": "[\"biodégradable\", \"respectueux de la nature\", \"compostable en milieu naturel\"]",
          "modifiable": true,
          "exportable": true,
          "importable": true,
          "supprimable": true
        }
      },
      "erreurs_possibles": [
        { "code": 400, "error": "Bad Request", "description": "Les champs 'nom' et 'valeur' sont obligatoires" },
        { "code": 409, "error": "Conflict", "description": "Un élément avec ce nom existe déjà" }
      ]
    },
    "PUT_config": {
      "action_id": "PUT_config",
      "endpoint": "/api/admin/config",
      "method": "PUT",
      "description": "Modifie la valeur et la description d'une variable de configuration existante",
      "parametres_attendus": {
        "headers": {
          "Content-Type": { "type": "string", "required": true, "default": "application/json" }
        },
        "body": {
          "id": { "type": "string", "required": true, "description": "Identifiant de la variable" },
          "valeur": { "type": "string", "required": true, "description": "Nouvelle valeur à appliquer" },
          "description": { "type": "string", "required": false, "description": "Description mise à jour" }
        }
      },
      "schema_entree": {
        "type": "object",
        "required": ["id", "valeur"],
        "properties": {
          "id": { "type": "string" },
          "valeur": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "schema_sortie": {
        "type": "object",
        "required": ["success", "message", "updated"],
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "updated": { "type": "object" }
        }
      },
