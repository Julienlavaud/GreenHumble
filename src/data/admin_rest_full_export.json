  "schemas": {
    "GET_config": {
      "champs_obligatoires": ["success", "endpoint", "total", "data"],
      "params": {
        "query": { "categorie": { "type": "string", "enum": ["variables_ia", "prompts", "templates_json", "dictionnaires", "regles_metier", "opportunites_metiers", "scoring", "conformite"] } }
      },
      "erreurs_possibles": [{ "code": 401, "error": "Unauthorized" }, { "code": 500, "error": "Internal Server Error" }]
    },
    "POST_config": {
      "champs_obligatoires": ["nom", "description", "categorie", "valeur"],
      "valeurs_par_defaut": { "modifiable": true, "exportable": true, "importable": true, "supprimable": true },
      "contraintes": { "nom": { "minLength": 3, "maxLength": 80, "pattern": "^[a-zA-Z0-9_-]+$" } },
      "erreurs_possibles": [{ "code": 400, "error": "Bad Request" }, { "code": 409, "error": "Conflict" }]
    },
    "PUT_config": {
      "champs_obligatoires": ["id", "valeur"],
      "contraintes": { "id": { "minLength": 2, "maxLength": 64 }, "valeur": { "minLength": 1, "maxLength": 50000 } },
      "erreurs_possibles": [{ "code": 400, "error": "Bad Request" }, { "code": 403, "error": "Forbidden" }, { "code": 404, "error": "Not Found" }]
    },
    "DELETE_config": {
      "champs_obligatoires": ["id"],
      "erreurs_possibles": [{ "code": 400, "error": "Bad Request" }, { "code": 403, "error": "Forbidden" }, { "code": 404, "error": "Not Found" }]
    },
    "GET_teams": {
      "champs_obligatoires": ["success", "endpoint", "equipes", "membres", "roles", "permissions", "groupes_metiers"],
      "erreurs_possibles": [{ "code": 401, "error": "Unauthorized" }, { "code": 403, "error": "Forbidden" }]
    },
    "POST_teams": {
      "champs_obligatoires": ["nom"],
      "valeurs_par_defaut": { "type": "membre", "role": "Auditeur RSE", "equipe": "Pôle Audit & Conformité RSE" },
      "erreurs_possibles": [{ "code": 400, "error": "Bad Request" }, { "code": 409, "error": "Conflict" }]
    },
    "PUT_teams": {
      "champs_obligatoires": ["membre_id"],
      "erreurs_possibles": [{ "code": 400, "error": "Bad Request" }, { "code": 404, "error": "Not Found" }]
    },
    "DELETE_teams": {
      "champs_obligatoires": ["id"],
      "erreurs_possibles": [{ "code": 400, "error": "Bad Request" }, { "code": 403, "error": "Forbidden" }, { "code": 404, "error": "Not Found" }]
    },
    "LOGIN": {
      "champs_obligatoires": ["email_or_user", "password"],
      "contraintes": { "password": { "minLength": 4, "maxLength": 128 } },
      "erreurs_possibles": [{ "code": 400, "error": "Bad Request" }, { "code": 401, "error": "Unauthorized" }, { "code": 429, "error": "Too Many Requests" }]
    },
    "LOGOUT": {
      "champs_obligatoires": ["success", "message"],
      "erreurs_possibles": [{ "code": 400, "error": "Bad Request" }]
    },
    "GET_session": {
      "champs_obligatoires": ["authenticated", "session_id", "user", "permissions"],
      "erreurs_possibles": [{ "code": 401, "error": "Unauthorized" }]
    }
  },
