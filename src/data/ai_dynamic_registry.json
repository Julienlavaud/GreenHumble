  "logique_dynamique": {
    "recuperation_automatique": {
      "frequence_rafraichissement_minutes": 60,
      "mecanisme": "Interrogation planifiée via GET /models chez Groq et Gemini. Tout nouveau modèle détecté est automatiquement ajouté à cl_ai_settings avec statut 'DISCOVERED' et activé s'il supporte JSON Mode.",
      "caching": "Mise en cache Redis/APCu de 3600 secondes avec réactualisation à chaud sans redémarrage serveur."
    },
    "gestion_versions_last": {
      "definition": "Les identifiants se terminant par '-last' sont des alias dynamiques résolus à la volée vers la version de production la plus récente fournie par l'API du provider.",
      "regle_resolution": "Si model == '*-last', l'orchestrateur extrait le préfixe de famille et injecte la sous-version taggée la plus récente issue du registre dynamique."
    },
    "selection_dynamique_provider_et_modele": {
      "ordre_priorite": [
        "1. Priorité aux paramètres explicites transmis dans le corps de requête ('preferred_provider', 'preferred_model')",
        "2. Si absent, lecture de la configuration active dans cl_ai_settings (nom: 'aiProvider', valeur: 'gemini' ou 'groq')",
        "3. Lecture de 'aiModel' par défaut pour ce provider (ex: 'gemini-3.8-flash' ou 'groq-llama-3.1-70b')",
        "4. En cas de surcharge de charge ou quota dépassé (HTTP 429), bascule instantanée sur le provider alternatif."
      ]
    },
    "politique_fallback_automatique": {
      "delai_expiration_timeout_ms": 6500,
      "nombre_essais_max": 2,
      "matrice_fallback": {
        "gemini-3.8-pro": "gemini-3.8-flash -> groq-llama-3.1-70b-last",
        "gemini-3.8-flash": "groq-llama-3.1-70b-last -> gemini-3.6-flash",
        "gemini-3.6-pro": "gemini-3.8-pro -> groq-llama-3.1-70b",
        "gemini-3.6-flash": "groq-llama-3.1-8b -> gemini-3.8-flash",
        "gemini-1.5-flash-last": "gemini-3.8-flash -> groq-llama-3.1-70b-last",
        "gemini-1.5-pro-last": "gemini-3.8-pro -> groq-llama-3.1-70b-last",
        "groq-llama-3.1-70b": "gemini-3.8-flash -> groq-llama-3.1-8b",
        "groq-llama-3.1-8b": "groq-llama-3.1-70b -> gemini-3.8-flash",
        "groq-mixtral-8x7b": "gemini-3.8-flash -> groq-llama-3.1-70b",
        "groq-allam-2-7b": "gemini-3.8-flash -> groq-llama-3.1-8b",
        "groq-llama-3.1-70b-last": "gemini-3.8-flash -> groq-llama-3.1-70b",
        "groq-mixtral-8x7b-last": "gemini-3.8-flash -> groq-mixtral-8x7b"
      }
    },
    "validation_dynamique_parametres": {
      "temperature": { "min": 0.0, "max": 1.0, "defaut": 0.25 },
      "max_tokens": { "min": 256, "max": 8192, "defaut": 4096 },
      "format_reponse": "application/json obligatoire avec json_schema strict"
    },
    "normalisation_dynamique_reponses": {
      "filtre_markdown": "Suppression systématique des blocs délimités par ```json et ```",
      "reparation_json": "Décodage avec rattrapage automatique des virgules orphelines et quotes non échappées",
      "injection_metadonnees": "Ajout automatique de l'objet 'ai_telemetry' contenant le modèle réel sollicité, le statut de fallback, la durée d'exécution en ms et le coût token estimé."
    }
  },
