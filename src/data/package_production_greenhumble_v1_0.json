{
  "package_production_greenhumble_v1_0": {
    "manifeste": {
      "titre": "Package de Production Complet Déploiement OVH — GreenHumble v1.1",
      "version": "1.0.0",
      "slogan": "Le climat, ensemble.",
      "affiliation": "Cabinet Climat Local (climatlocal.com)",
      "date_release": "2026-10-02T14:30:21Z",
      "cible_hebergement": "OVH Cloud / Web Hosting Mutualisé (Apache 2.4+ / PHP 8.2+)",
      "versioning_cache_ovh": "?v=floor(time()/60)*60",
      "mode_execution": "Production Réelle sans Mocks (API Gemini 3.8-Flash & Groq)"
    },
    "backend_php_api": {
      "moteur_ia_central": "/api/includes/ai_engine.php",
      "fonction_principale": "analyze_url_with_ai($url, $customPrompt, $csrDocumentText)",
      "connecteur_gemini": "/api/includes/gemini.php (call_gemini)",
      "connecteur_groq": "/api/includes/groq.php (call_groq)",
      "cascade_modeles": [
        "1. gemini-3.8-flash",
        "2. gemini-2.5-flash",
        "3. gemini-2.0-flash",
        "4. llama-3.3-70b-versatile (Groq Cloud)"
      ],
      "endpoints_rest": [
        "POST /api/audit",
        "GET/POST/PATCH /api/prospec",
        "GET /api/audits",
        "GET /api/state",
        "GET /api/flush.php"
      ]
    },
    "frontend_admin_ui": {
      "pages_php": [
        "/admin/index.php",
        "/admin/audit.php",
        "/admin/dashboard.php",
        "/admin/config.php",
        "/admin/prospec.php",
        "/admin/teams.php",
        "/admin/backup.php"
      ],
      "modules_js": [
        "/admin/assets/js/admin.js",
        "/admin/assets/js/audit.js",
        "/admin/assets/js/dashboard.js",
        "/admin/assets/js/prospec.js",
        "/admin/assets/js/config.js",
        "/admin/assets/js/teams.js",
        "/admin/assets/js/backup.js"
      ],
      "feuilles_styles": [
        "/admin/assets/css/styles.css",
        "/admin/assets/css/admin.css",
        "/admin/assets/css/dashboard.css",
        "/admin/assets/css/audit.css",
        "/admin/assets/css/prospec.css",
        "/admin/assets/css/config.css",
        "/admin/assets/css/teams.css"
      ],
      "correctifs_ui": {
        "menus_flex_grid": "6 menus corrigés avec typographie Inter et hover states",
        "console_admin_boutons": ["➕ Créer une règle", "✏️ Modifier", "🗑️ Effacer", "📥 Importer", "📤 Exporter"],
        "dashboard_filtre_annee": "Sélecteur d'année 2024 / 2025 / 2026 fonctionnel",
        "cartes_restitution": "Cartes modulaires d'allégations RSE avec niveau de risque et articles de loi"
      }
    },
    "deploiement_ovh": {
      "script_installation": "/install.php",
      "purgeur_opcache": "/api/flush.php",
      "fichier_htaccess": "/.htaccess",
      "directives_securite": [
        "RewriteCond %{HTTPS} off -> Forcer HTTPS",
        "Header set Cache-Control 'no-store, no-cache, must-revalidate, max-age=0'",
        "Require all denied sur .env et config.php",
        "RewriteRule ^api/(.*)$ api/router.php [L,QSA]"
      ]
    },
    "statut_recette_globale": {
      "mode_bac_a_sable_desactive": true,
      "api_reelles_gemini_groq_actives": true,
      "cartes_restitution_front_actives": true,
      "compatibilite_ovh_100_pourcent": true,
      "format_json_strict": true
    }
  }
}
