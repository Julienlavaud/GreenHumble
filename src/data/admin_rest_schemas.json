{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GreenHumble Admin REST Actions Schemas",
  "version": "2.0.0",
  "description": "Schémas stricts, types, contraintes, valeurs par défaut et erreurs pour toutes les actions REST du cockpit GreenHumble.",
  "actions": {
    "GET_config": {
      "action_id": "GET_config",
      "endpoint": "/api/admin/config",
      "method": "GET",
      "description": "Récupération de la liste filtrable des configurations IA, règles métier et scoring",
      "champs_obligatoires": {
        "params": [],
        "reponse": ["success", "endpoint", "total", "data"]
      },
      "parametres": {
        "query": {
          "type": "object",
          "properties": {
            "categorie": {
              "type": "string",
              "enum": [
                "variables_ia",
                "prompts",
                "templates_json",
                "dictionnaires",
                "regles_metier",
                "opportunites_metiers",
                "scoring",
                "conformite"
              ],
              "description": "Filtrage optionnel par catégorie de configuration",
              "default": null
            }
          },
          "additionalProperties": false
        },
        "headers": {
          "type": "object",
          "properties": {
            "Authorization": {
              "type": "string",
              "pattern": "^Bearer\\s[A-Za-z0-9-_=.]+$",
              "description": "Jeton d'authentification Bearer JWT"
            }
          }
        }
      },
      "schema_reponse": {
        "type": "object",
        "required": ["success", "endpoint", "total", "data"],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "endpoint": {
            "type": "string",
            "const": "/api/admin/config"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "nom", "description", "categorie", "valeur", "modifiable", "exportable", "importable", "supprimable"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9_]+$"
                },
                "nom": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 100
                },
                "description": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 500
                },
                "categorie": {
                  "type": "string",
                  "enum": [
                    "variables_ia",
                    "prompts",
                    "templates_json",
                    "dictionnaires",
                    "regles_metier",
                    "opportunites_metiers",
                    "scoring",
                    "conformite"
                  ]
                },
                "valeur": {
                  "type": "string",
                  "minLength": 1
                },
                "modifiable": {
                  "type": "boolean",
                  "default": true
                },
                "exportable": {
                  "type": "boolean",
                  "default": true
                },
                "importable": {
                  "type": "boolean",
                  "default": true
                },
                "supprimable": {
                  "type": "boolean",
                  "default": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "erreurs_possibles": [
        {
          "code": 401,
          "error": "Unauthorized",
          "description": "Session non authentifiée ou jeton Bearer manquant / invalide"
        },
        {
          "code": 500,
          "error": "Internal Server Error",
          "description": "Erreur d'accès au fichier de configuration JSON ou à la base de données"
        }
      ]
    },
    "POST_config": {
      "action_id": "POST_config",
      "endpoint": "/api/admin/config",
      "method": "POST",
      "description": "Création d'un paramètre, règle métier ou dictionnaire personnalisé",
      "champs_obligatoires": {
        "body": ["nom", "description", "categorie", "valeur"],
        "reponse": ["success", "message", "item"]
      },
      "valeurs_par_defaut": {
        "categorie": "variables_ia",
        "modifiable": true,
        "exportable": true,
        "importable": true,
        "supprimable": true
      },
      "contraintes": {
        "nom": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Identifiant technique lisible sans espace"
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "categorie": {
          "type": "string",
          "enum": [
            "variables_ia",
            "prompts",
            "templates_json",
            "dictionnaires",
            "regles_metier",
            "opportunites_metiers",
            "scoring",
            "conformite"
          ]
        },
        "valeur": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "modifiable": { "type": "boolean" },
        "exportable": { "type": "boolean" },
        "importable": { "type": "boolean" },
        "supprimable": { "type": "boolean" }
      },
      "schema_entree": {
        "type": "object",
        "required": ["nom", "description", "categorie", "valeur"],
        "properties": {
          "nom": { "type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[a-zA-Z0-9_-]+$" },
          "description": { "type": "string", "minLength": 5, "maxLength": 500 },
          "categorie": {
            "type": "string",
            "enum": [
              "variables_ia",
              "prompts",
              "templates_json",
              "dictionnaires",
              "regles_metier",
              "opportunites_metiers",
              "scoring",
              "conformite"
            ],
            "default": "variables_ia"
          },
          "valeur": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "modifiable": { "type": "boolean", "default": true },
          "exportable": { "type": "boolean", "default": true },
          "importable": { "type": "boolean", "default": true },
          "supprimable": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      },
      "schema_reponse": {
        "type": "object",
        "required": ["success", "message", "item"],
        "properties": {
          "success": { "type": "boolean", "const": true },
          "message": { "type": "string" },
          "item": {
            "type": "object",
            "required": ["id", "nom", "description", "categorie", "valeur", "modifiable", "exportable", "importable", "supprimable"]
          }
        },
        "additionalProperties": false
      },
      "erreurs_possibles": [
        {
          "code": 400,
          "error": "Bad Request",
          "description": "Validation échouée : champs obligatoires manquants ou format non conforme"
        },
        {
          "code": 409,
          "error": "Conflict",
          "description": "Une variable portant ce nom technique existe déjà dans le registre"
        }
      ]
    },
    "PUT_config": {
      "action_id": "PUT_config",
      "endpoint": "/api/admin/config",
      "method": "PUT",
      "description": "Modification de la valeur ou de la description d'une variable existante",
      "champs_obligatoires": {
        "body": ["id", "valeur"],
        "reponse": ["success", "message", "updated"]
      },
      "valeurs_par_defaut": {},
      "contraintes": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "valeur": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        }
      },
      "schema_entree": {
        "type": "object",
        "required": ["id", "valeur"],
        "properties": {
          "id": { "type": "string", "minLength": 2, "maxLength": 64 },
          "valeur": { "type": "string", "minLength": 1, "maxLength": 50000 },
          "description": { "type": "string", "minLength": 5, "maxLength": 1000 }
        },
        "additionalProperties": false
      },
      "schema_reponse": {
        "type": "object",
        "required": ["success", "message", "updated"],
        "properties": {
          "success": { "type": "boolean", "const": true },
          "message": { "type": "string" },
          "updated": {
            "type": "object",
            "required": ["id", "valeur"]
          }
        },
        "additionalProperties": false
      },
      "erreurs_possibles": [
        {
          "code": 400,
          "error": "Bad Request",
          "description": "Identifiant 'id' ou 'valeur' manquant"
        },
        {
          "code": 403,
          "error": "Forbidden",
          "description": "Action interdite : cette variable est marquée 'modifiable: false'"
        },
        {
          "code": 404,
          "error": "Not Found",
          "description": "Aucune variable ne correspond à l'identifiant fourni"
        }
      ]
    },
    "DELETE_config": {
      "action_id": "DELETE_config",
      "endpoint": "/api/admin/config",
      "method": "DELETE",
      "description": "Suppression définitive d'un élément de configuration",
      "champs_obligatoires": {
        "params": ["id"],
        "reponse": ["success", "message", "deleted_id"]
      },
      "valeurs_par_defaut": {},
      "contraintes": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        }
      },
      "schema_entree": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 2, "maxLength": 64 }
        },
        "additionalProperties": false
      },
      "schema_reponse": {
        "type": "object",
        "required": ["success", "message", "deleted_id"],
        "properties": {
          "success": { "type": "boolean", "const": true },
          "message": { "type": "string" },
          "deleted_id": { "type": "string" }
        },
        "additionalProperties": false
      },
      "erreurs_possibles": [
        {
          "code": 400,
          "error": "Bad Request",
          "description": "Identifiant 'id' absent de la requête"
        },
        {
          "code": 403,
          "error": "Forbidden",
          "description": "Suppression refusée : cet élément système est protégé ('supprimable: false')"
        },
        {
          "code": 404,
          "error": "Not Found",
          "description": "Élément introuvable"
        }
      ]
    },
    "GET_teams": {
      "action_id": "GET_teams",
      "endpoint": "/api/admin/teams",
      "method": "GET",
      "description": "Consultation de l'organigramme, collaborateurs, rôles RBAC et groupes métiers",
      "champs_obligatoires": {
        "params": [],
        "reponse": ["success", "endpoint", "equipes", "membres", "roles", "permissions", "groupes_metiers"]
      },
      "valeurs_par_defaut": {},
      "contraintes": {
        "equipe_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50
        }
      },
      "schema_entree": {
        "type": "object",
        "properties": {
          "equipe_id": { "type": "string", "minLength": 2, "maxLength": 50 }
        },
        "additionalProperties": false
      },
      "schema_reponse": {
        "type": "object",
        "required": ["success", "endpoint", "equipes", "membres", "roles", "permissions", "groupes_metiers"],
        "properties": {
          "success": { "type": "boolean", "const": true },
          "endpoint": { "type": "string", "const": "/api/admin/teams" },
          "equipes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "nom", "actif"],
              "properties": {
                "id": { "type": "string" },
                "nom": { "type": "string" },
                "region": { "type": "string" },
                "chef": { "type": "string" },
                "actif": { "type": "boolean" }
              }
            }
          },
          "membres": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "nom", "email", "role", "equipe", "statut"],
              "properties": {
                "id": { "type": "string" },
                "nom": { "type": "string" },
                "email": { "type": "string", "format": "email" },
                "role": { "type": "string" },
                "equipe": { "type": "string" },
                "statut": { "type": "string", "enum": ["actif", "suspendu", "invité"] }
              }
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "nom", "niveau", "description"],
              "properties": {
                "id": { "type": "string" },
                "nom": { "type": "string" },
                "niveau": { "type": "integer", "minimum": 1, "maximum": 100 },
                "description": { "type": "string" }
              }
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "label"],
              "properties": {
                "code": { "type": "string", "pattern": "^[a-z0-9_:]+$" },
                "label": { "type": "string" }
              }
            }
          },
          "groupes_metiers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "nom", "specialite"],
              "properties": {
                "id": { "type": "string" },
                "nom": { "type": "string" },
                "specialite": { "type": "string" }
              }
            }
          }
        },
        "additionalProperties": false
      },
      "erreurs_possibles": [
        {
          "code": 401,
          "error": "Unauthorized",
          "description": "Authentification requise pour visualiser les équipes"
        },
        {
          "code": 403,
          "error": "Forbidden",
          "description": "Niveau d'accès insuffisant"
        }
      ]
    },
    "POST_teams": {
      "action_id": "POST_teams",
      "endpoint": "/api/admin/teams",
      "method": "POST",
      "description": "Création d'un collaborateur ou d'une équipe territoriale",
      "champs_obligatoires": {
        "body": ["nom"],
        "reponse": ["success", "message"]
      },
      "valeurs_par_defaut": {
        "type": "membre",
        "role": "Auditeur RSE",
        "equipe": "Pôle Audit & Conformité RSE",
        "statut": "actif"
      },
      "contraintes": {
        "type": { "type": "string", "enum": ["membre", "equipe"] },
        "nom": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "role": { "type": "string", "minLength": 2, "maxLength": 60 },
        "equipe": { "type": "string", "minLength": 2, "maxLength": 80 }
      },
      "schema_entree": {
        "type": "object",
        "required": ["nom"],
        "properties": {
          "type": { "type": "string", "enum": ["membre", "equipe"], "default": "membre" },
          "nom": { "type": "string", "minLength": 2, "maxLength": 100 },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "default": "Auditeur RSE" },
          "equipe": { "type": "string", "default": "Pôle Audit & Conformité RSE" }
        },
        "additionalProperties": false
      },
      "schema_reponse": {
        "type": "object",
        "required": ["success", "message"],
        "properties": {
          "success": { "type": "boolean", "const": true },
          "message": { "type": "string" },
          "membre": { "type": "object" },
          "equipe": { "type": "object" }
        },
        "additionalProperties": false
      },
      "erreurs_possibles": [
        {
          "code": 400,
          "error": "Bad Request",
          "description": "Nom obligatoire ou format d'adresse email invalide"
        },
        {
          "code": 409,
          "error": "Conflict",
          "description": "Un membre avec cette adresse email existe déjà"
        }
      ]
    },
    "PUT_teams": {
      "action_id": "PUT_teams",
      "endpoint": "/api/admin/teams",
      "method": "PUT",
      "description": "Mise à jour du rôle, des permissions ou de l'équipe de rattachement d'un collaborateur",
      "champs_obligatoires": {
        "body": ["membre_id"],
        "reponse": ["success", "message", "updated_member"]
      },
      "valeurs_par_defaut": {},
      "contraintes": {
        "membre_id": { "type": "string", "minLength": 2, "maxLength": 50 },
        "role": { "type": "string", "minLength": 2, "maxLength": 60 },
        "equipe": { "type": "string", "minLength": 2, "maxLength": 80 },
        "statut": { "type": "string", "enum": ["actif", "suspendu"] }
      },
      "schema_entree": {
        "type": "object",
        "required": ["membre_id"],
        "properties": {
          "membre_id": { "type": "string", "minLength": 2, "maxLength": 50 },
          "role": { "type": "string", "minLength": 2, "maxLength": 60 },
          "equipe": { "type": "string", "minLength": 2, "maxLength": 80 },
          "statut": { "type": "string", "enum": ["actif", "suspendu"] }
        },
        "additionalProperties": false
      },
      "schema_reponse": {
        "type": "object",
        "required": ["success", "message", "updated_member"],
        "properties": {
          "success": { "type": "boolean", "const": true },
          "message": { "type": "string" },
          "updated_member": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "role": { "type": "string" },
              "equipe": { "type": "string" },
              "updated_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "additionalProperties": false
      },
      "erreurs_possibles": [
        {
          "code": 400,
          "error": "Bad Request",
          "description": "Paramètre 'membre_id' absent"
        },
        {
          "code": 403,
          "error": "Forbidden",
          "description": "Impossibilité de rétrograder le compte Super Administrateur maître"
        },
        {
          "code": 404,
          "error": "Not Found",
          "description": "Collaborateur introuvable"
        }
      ]
    },
    "DELETE_teams": {
      "action_id": "DELETE_teams",
      "endpoint": "/api/admin/teams",
      "method": "DELETE",
      "description": "Suppression ou révocation d'un membre ou d'un pôle régional",
      "champs_obligatoires": {
        "params": ["id"],
        "reponse": ["success", "message", "deleted_id"]
      },
      "valeurs_par_defaut": {},
      "contraintes": {
        "id": { "type": "string", "minLength": 2, "maxLength": 50 }
      },
      "schema_entree": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 2, "maxLength": 50 }
        },
        "additionalProperties": false
      },
      "schema_reponse": {
        "type": "object",
        "required": ["success", "message", "deleted_id"],
        "properties": {
          "success": { "type": "boolean", "const": true },
          "message": { "type": "string" },
          "deleted_id": { "type": "string" }
        },
        "additionalProperties": false
      },
      "erreurs_possibles": [
        {
          "code": 400,
          "error": "Bad Request",
          "description": "Identifiant du membre ou de l'équipe manquant"
        },
        {
          "code": 403,
          "error": "Forbidden",
          "description": "Suppression interdite pour le Super Administrateur ou dernier administrateur actif"
        },
        {
          "code": 404,
          "error": "Not Found",
          "description": "Identifiant introuvable"
        }
      ]
    },
    "LOGIN": {
      "action_id": "LOGIN",
      "endpoint": "/api/admin/auth",
      "method": "POST",
      "description": "Authentification sécurisée avec génération de token de session JWT",
      "champs_obligatoires": {
        "body": ["email_or_user", "password"],
        "reponse": ["success", "token", "expires_in", "user"]
      },
      "valeurs_par_defaut": {},
      "contraintes": {
        "email_or_user": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "password": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128
        }
      },
      "schema_entree": {
        "type": "object",
        "required": ["email_or_user", "password"],
        "properties": {
          "email_or_user": { "type": "string", "minLength": 3, "maxLength": 100 },
          "password": { "type": "string", "format": "password", "minLength": 4, "maxLength": 128 }
        },
        "additionalProperties": false
      },
      "schema_reponse": {
        "type": "object",
        "required": ["success", "token", "expires_in", "user"],
        "properties": {
          "success": { "type": "boolean", "const": true },
          "token": {
            "type": "string",
            "pattern": "^gh_jwt_[A-Za-z0-9-_=.]+$"
          },
          "expires_in": {
            "type": "integer",
            "enum": [86400]
          },
          "user": {
            "type": "object",
            "required": ["id", "username", "email", "nom", "role", "access_level"],
            "properties": {
              "id": { "type": "string" },
              "username": { "type": "string" },
              "email": { "type": "string", "format": "email" },
              "nom": { "type": "string" },
              "role": { "type": "string" },
              "access_level": { "type": "integer", "minimum": 10, "maximum": 100 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "erreurs_possibles": [
        {
          "code": 400,
          "error": "Bad Request",
          "description": "Identifiant ou mot de passe non renseigné"
        },
        {
          "code": 401,
          "error": "Unauthorized",
          "description": "Identifiant inconnu ou mot de passe erroné"
        },
        {
          "code": 429,
          "error": "Too Many Requests",
          "description": "Dépassement du seuil de 5 tentatives infructueuses (verrouillage temporaire de 15 minutes)"
        }
      ]
    },
    "LOGOUT": {
      "action_id": "LOGOUT",
      "endpoint": "/api/admin/auth",
      "method": "DELETE",
      "description": "Révocation du jeton de session et destruction des cookies d'authentification",
      "champs_obligatoires": {
        "reponse": ["success", "message"]
      },
      "valeurs_par_defaut": {},
      "contraintes": {},
      "schema_entree": {
        "type": "null"
      },
      "schema_reponse": {
        "type": "object",
        "required": ["success", "message"],
        "properties": {
          "success": { "type": "boolean", "const": true },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      },
      "erreurs_possibles": [
        {
          "code": 400,
          "error": "Bad Request",
          "description": "Aucune session active à clore"
        }
      ]
    },
    "GET_session": {
      "action_id": "GET_session",
      "endpoint": "/api/admin/auth",
      "method": "GET",
      "description": "Vérification de l'état de connexion de l'utilisateur pour hydratation du badge UI",
      "champs_obligatoires": {
        "reponse": ["authenticated", "session_id", "user", "permissions"]
      },
      "valeurs_par_defaut": {},
      "contraintes": {},
      "schema_entree": {
        "type": "null"
      },
      "schema_reponse": {
        "type": "object",
        "required": ["authenticated", "session_id", "user", "permissions"],
        "properties": {
          "authenticated": { "type": "boolean" },
          "session_id": { "type": "string" },
          "user": {
