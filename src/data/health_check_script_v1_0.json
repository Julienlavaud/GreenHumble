          "version_minimale": "8.2.0",
          "version_recommandee": "8.3.x",
          "statut_attendu": "OK",
          "commande_verification": "php -r \"echo version_compare(PHP_VERSION, '8.2.0', '>=') ? 'PASSED' : 'FAILED';\""
        },
        "extensions_requises": [
          { "nom": "pdo_mysql", "statut": "ACTIVE", "necessaire_pour": "Persistance des 10 tables cl_* et transactions relationnelles sécurisées" },
          { "nom": "curl", "statut": "ACTIVE", "necessaire_pour": "Appels HTTP REST vers Gemini API, Groq Cloud et scraping d'audit" },
          { "nom": "mbstring", "statut": "ACTIVE", "necessaire_pour": "Sanitation UTF-8 et manipulation des allégations textuelles" },
