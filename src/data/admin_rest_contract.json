              "equipe": "Pôle Audit & Conformité RSE",
              "statut": "invité",
              "created_at": "2026-10-02T02:15:36Z"
            }
          },
          "errors": [
            { "code": 400, "message": "Adresse email invalide ou incomplète" },
            { "code": 409, "message": "Un utilisateur avec cet email existe déjà" }
          ]
        },
        "PUT_teams": {
          "method": "PUT",
          "action_id": "PUT_teams",
          "description": "Modifie les rôles, permissions ou l'affectation d'un membre",
          "parameters": {
            "body": {
              "membre_id": { "type": "string", "required": true },
              "role_id": { "type": "string", "required": false },
              "equipe_id": { "type": "string", "required": false },
              "statut": { "type": "string", "enum": ["actif", "suspendu"], "required": false }
            }
          },
          "schema": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "message": { "type": "string" },
              "updated_member": { "type": "object" }
            }
          },
          "mock_response": {
            "success": true,
            "message": "Rôle et affectation mis à jour",
            "updated_member": {
              "id": "usr_02",
              "role": "Lead Prospection",
              "niveau": 40,
              "updated_at": "2026-10-02T02:15:36Z"
            }
          },
          "errors": [
            { "code": 404, "message": "Membre introuvable" },
            { "code": 403, "message": "Impossible de modifier les privilèges du Super Administrateur racine" }
          ]
        },
        "DELETE_teams": {
          "method": "DELETE",
          "action_id": "DELETE_teams",
          "description": "Retire un membre d'une équipe ou désactive son accès",
          "parameters": {
            "query": {
              "membre_id": { "type": "string", "required": true }
            }
          },
          "schema": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "message": { "type": "string" },
              "deleted_id": { "type": "string" }
            }
          },
          "mock_response": {
            "success": true,
            "message": "Membre retiré de l'équipe et accès révoqué",
            "deleted_id": "usr_03"
          },
          "errors": [
            { "code": 400, "message": "Identifiant de membre requis" },
            { "code": 403, "message": "Révocation impossible pour le dernier administrateur actif" }
          ]
        }
      },
      "ui_bindings": {
        "GET_teams": {
          "component": "Table équipes",
          "target_element": "#teams-datagrid",
          "view_type": "TeamHierarchyTable",
          "columns": ["collaborateur", "email", "role_badge", "equipe", "statut_connexion", "actions"]
        },
        "POST_teams": {
          "component": "Formulaire ajout membre",
          "target_element": "#modal-add-member",
          "view_type": "ModalForm",
          "inputs": ["nom_complet", "email_professionnel", "select_role", "select_equipe", "select_groupe_metier"]
        },
        "PUT_teams": {
          "component": "Formulaire modification rôle",
          "target_element": "#drawer-edit-role",
          "view_type": "RolePermissionMatrixForm",
          "inputs": ["select_role", "checkbox_permissions_override", "select_equipe_rattachement"]
        },
        "DELETE_teams": {
          "component": "Bouton suppression membre",
          "target_element": ".btn-remove-member",
          "view_type": "DestructiveConfirmationAlert",
          "confirm_message": "Confirmez-vous la révocation définitive de ce collaborateur ?"
        }
      }
    },
    {
      "endpoint": "/api/admin/auth",
      "description": "Gestion de l'authentification sécurisée, des identifiants chiffrés, des jetons JWT et du cycle de vie des sessions.",
      "methods": ["POST", "DELETE", "GET"],
      "categories": [
        "utilisateurs",
        "emails",
        "mots_de_passe_hashes",
        "niveaux_acces",
        "tokens",
        "sessions"
      ],
      "actions": {
        "LOGIN": {
          "method": "POST",
          "action_id": "LOGIN",
          "description": "Authentifie l'administrateur avec identifiants chiffrés et délivre un jeton de session",
          "parameters": {
            "body": {
              "email_or_user": { "type": "string", "required": true },
              "password": { "type": "string", "format": "password", "required": true }
            }
          },
          "schema": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "token": { "type": "string" },
              "expires_in": { "type": "integer" },
              "user": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "username": { "type": "string" },
                  "email": { "type": "string" },
                  "role": { "type": "string" },
                  "access_level": { "type": "integer" }
                }
              }
            }
          },
          "mock_response": {
            "success": true,
            "token": "gh_jwt_eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.s87df6sd87fs6d.98f7ds",
            "expires_in": 86400,
            "user": {
              "id": "usr_master_admin",
              "username": "admin_master",
              "email": "admin@greenhumble.local",
              "role": "Super Administrateur",
              "access_level": 100
            }
          },
          "errors": [
            { "code": 401, "message": "Identifiant ou mot de passe incorrect" },
            { "code": 429, "message": "Trop de tentatives échouées. Compte temporairement verrouillé pour 15 minutes." }
          ]
        },
        "LOGOUT": {
          "method": "DELETE",
          "action_id": "LOGOUT",
          "description": "Invalide le jeton actif et détruit le cookie de session",
          "parameters": {
            "headers": {
              "Authorization": { "type": "string", "required": true, "description": "Bearer <token>" }
            }
          },
          "schema": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "message": { "type": "string" }
            }
          },
          "mock_response": {
            "success": true,
            "message": "Déconnexion réussie, session révoquée"
          },
          "errors": [
            { "code": 400, "message": "Aucune session active à clore" }
          ]
        },
        "GET_session": {
          "method": "GET",
          "action_id": "GET_session",
          "description": "Vérifie la validité de la session active et renvoie l'état du profil connecté",
          "parameters": {
            "headers": {
              "Authorization": { "type": "string", "required": true }
            }
          },
          "schema": {
            "type": "object",
            "properties": {
              "authenticated": { "type": "boolean" },
              "session_id": { "type": "string" },
              "user": { "type": "object" },
              "permissions": { "type": "array" }
            }
          },
          "mock_response": {
            "authenticated": true,
            "session_id": "sess_89f0a2c1b4e5",
            "user": {
              "id": "usr_master_admin",
              "nom": "Administrateur GreenHumble",
              "email": "admin@greenhumble.local",
              "role": "Super Administrateur",
              "access_level": 100,
              "avatar_initials": "GH",
              "last_login": "2026-10-02T02:10:00Z"
            },
            "permissions": ["all", "config:write", "teams:write", "audit:write"]
          },
          "errors": [
            { "code": 401, "message": "Session invalide ou expirée" }
          ]
        }
      },
      "ui_bindings": {
        "LOGIN": {
          "component": "Formulaire de connexion",
          "target_element": "#auth-login-card",
          "view_type": "AuthenticationCard",
          "inputs": ["input_email", "input_password", "checkbox_remember_me", "submit_button"]
        },
        "LOGOUT": {
          "component": "Bouton déconnexion",
          "target_element": "#btn-user-logout",
          "view_type": "NavigationActionItem",
          "event_handler": "handleSessionRevoke()"
        },
        "GET_session": {
          "component": "Badge utilisateur connecté",
          "target_element": "#navbar-user-profile-badge",
          "view_type": "UserSessionStatusPill",
          "displays": ["avatar_or_initials", "nom_utilisateur", "role_badge", "indicator_en_ligne"]
        }
      }
    }
  ]
}
