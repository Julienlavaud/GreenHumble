{
  "project": "GreenHumble Admin Console",
  "version": "2.0.0",
  "architecture": "REST Modulaire - AI Studio Client Simulation",
  "description": "Spécification REST complète avec schemas, mock responses réalistes, paramètres, erreurs et bindings UI pour le viewer AI Studio sans backend.",
  "endpoints": [
    {
      "endpoint": "/api/admin/config",
      "description": "Gestion modulaire de toute la configuration IA, règles métiers, prompts, scoring et conformité.",
      "methods": ["GET", "POST", "PUT", "DELETE"],
      "categories": [
        "variables_ia",
        "prompts",
        "templates_json",
        "dictionnaires",
        "regles_metier",
        "opportunites_metiers",
        "scoring",
        "conformite"
      ],
      "actions": {
        "GET_config": {
          "method": "GET",
          "action_id": "GET_config",
          "description": "Récupère l'ensemble des configurations actives du moteur IA",
          "parameters": {
            "query": {
              "categorie": {
                "type": "string",
                "required": false,
                "description": "Filtrer par catégorie spécifique"
              }
            }
          },
          "schema": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "total": { "type": "integer" },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "nom", "description", "categorie", "valeur", "modifiable", "exportable", "importable", "supprimable"],
                  "properties": {
                    "id": { "type": "string" },
                    "nom": { "type": "string" },
                    "description": { "type": "string" },
                    "categorie": { "type": "string" },
                    "valeur": { "type": "string" },
                    "modifiable": { "type": "boolean" },
                    "exportable": { "type": "boolean" },
                    "importable": { "type": "boolean" },
                    "supprimable": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "mock_response": {
            "success": true,
            "total": 8,
            "data": [
              {
                "id": "cfg_ai_provider",
                "nom": "aiProvider",
                "description": "Moteur d'inférence actif pour les scans",
                "categorie": "variables_ia",
                "valeur": "groq",
                "modifiable": true,
                "exportable": true,
                "importable": true,
                "supprimable": false
              },
              {
                "id": "cfg_ai_model",
                "nom": "aiModel",
                "description": "Modèle d'extraction et de scoring recommandé",
                "categorie": "variables_ia",
                "valeur": "llama-3.1-70b",
                "modifiable": true,
                "exportable": true,
                "importable": true,
                "supprimable": false
              },
              {
                "id": "cfg_prompt_sys",
                "nom": "system_prompt_greenhumble",
                "description": "Directives d'audit juridique et de conformité",
                "categorie": "prompts",
                "valeur": "Tu es l'analyste expert GreenHumble. Évalue la conformité des allégations environnementales avec le décret Green Claims et la loi Climat.",
                "modifiable": true,
                "exportable": true,
                "importable": true,
                "supprimable": true
              },
              {
                "id": "cfg_tpl_audit",
                "nom": "template_audit",
                "description": "Structure JSON standard des résultats d'audit",
                "categorie": "templates_json",
                "valeur": "{\"score_global\": 0, \"allegations\": [], \"preuves\": [], \"risques\": []}",
                "modifiable": true,
                "exportable": true,
                "importable": true,
                "supprimable": true
              },
              {
                "id": "cfg_dict_sig",
                "nom": "signaux_faibles",
                "description": "Termes environnementaux surveillés",
                "categorie": "dictionnaires",
                "valeur": "[\"neutre en carbone\", \"100% vert\", \"éco-responsable\", \"zéro émission\"]",
                "modifiable": true,
                "exportable": true,
                "importable": true,
                "supprimable": true
              },
              {
                "id": "cfg_regle_gc",
                "nom": "regles_green_claims",
                "description": "Interdiction de neutralité sans compensation prouvée",
                "categorie": "regles_metier",
                "valeur": "Toute allégation de neutralité carbone doit s'appuyer sur un bilan GES scopes 1, 2 et 3 vérifié.",
                "modifiable": true,
                "exportable": true,
                "importable": true,
                "supprimable": true
              },
              {
                "id": "cfg_opp_csrd",
                "nom": "opportunites_metiers",
                "description": "Opportunités de mise en conformité et de valorisation",
                "categorie": "opportunites_metiers",
                "valeur": "[\"Accompagnement reporting CSRD\", \"Valorisation d'ACV normées\"]",
                "modifiable": true,
                "exportable": true,
                "importable": true,
                "supprimable": true
              },
              {
                "id": "cfg_score_weights",
                "nom": "scoreAuditWeights",
                "description": "Pondération du calcul du score d'audit",
                "categorie": "scoring",
                "valeur": "{\"preuves\": 0.40, \"conformite\": 0.35, \"transparence\": 0.25}",
                "modifiable": true,
                "exportable": true,
                "importable": true,
                "supprimable": true
              }
            ]
          },
          "errors": [
            { "code": 401, "message": "Non autorisé : token de session manquant ou expiré" },
            { "code": 500, "message": "Erreur serveur interne lors du chargement des configurations" }
          ]
        },
        "POST_config": {
          "method": "POST",
          "action_id": "POST_config",
          "description": "Ajoute un nouvel élément de configuration ou dictionnaire",
          "parameters": {
            "body": {
              "nom": { "type": "string", "required": true },
              "description": { "type": "string", "required": true },
              "categorie": { "type": "string", "required": true },
              "valeur": { "type": "string", "required": true },
              "modifiable": { "type": "boolean", "default": true },
              "exportable": { "type": "boolean", "default": true },
              "importable": { "type": "boolean", "default": true },
              "supprimable": { "type": "boolean", "default": true }
            }
          },
          "schema": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "message": { "type": "string" },
              "item": { "type": "object" }
            }
          },
          "mock_response": {
            "success": true,
            "message": "Élément de configuration ajouté avec succès",
            "item": {
              "id": "cfg_custom_789",
              "nom": "nouveau_mot_cle_rse",
              "description": "Mot-clé additionnel pour détection d'allégations",
              "categorie": "dictionnaires",
              "valeur": "[\"biodégradable\", \"bio-sourcé\"]",
              "modifiable": true,
              "exportable": true,
              "importable": true,
              "supprimable": true
            }
          },
          "errors": [
            { "code": 400, "message": "Données invalides : champs obligatoires manquants" },
            { "code": 409, "message": "Conflit : une clé avec ce nom existe déjà" }
          ]
        },
        "PUT_config": {
          "method": "PUT",
          "action_id": "PUT_config",
          "description": "Modifie la valeur et la description d'une variable de configuration existante",
          "parameters": {
            "body": {
              "id": { "type": "string", "required": true },
              "valeur": { "type": "string", "required": true },
              "description": { "type": "string", "required": false }
            }
          },
          "schema": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "message": { "type": "string" },
              "updated": { "type": "object" }
            }
          },
          "mock_response": {
            "success": true,
            "message": "Configuration mise à jour avec succès",
            "updated": {
              "id": "cfg_ai_model",
              "valeur": "mixtral-8x7b",
              "description": "Modèle haute performance pour synthèse longue",
              "updated_at": "2026-10-02T02:15:00Z"
            }
          },
          "errors": [
            { "code": 403, "message": "Action refusée : cet élément est verrouillé en modification" },
            { "code": 404, "message": "Élément introuvable" }
          ]
        },
        "DELETE_config": {
          "method": "DELETE",
          "action_id": "DELETE_config",
          "description": "Supprime un élément de configuration personnalisée",
          "parameters": {
            "query": {
              "id": { "type": "string", "required": true }
            }
          },
          "schema": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "deleted_id": { "type": "string" },
              "message": { "type": "string" }
            }
          },
          "mock_response": {
            "success": true,
            "deleted_id": "cfg_custom_789",
            "message": "Configuration supprimée du registre"
          },
          "errors": [
            { "code": 400, "message": "Identifiant manquant" },
            { "code": 403, "message": "Cet élément système est protégé contre la suppression" }
          ]
        }
      },
      "ui_bindings": {
        "GET_config": {
          "component": "Table de configuration IA",
          "target_element": "#ai-config-datatable",
          "view_type": "DataGrid",
          "features": ["filtrage_par_categorie", "recherche_textuelle", "badge_statut", "export_csv_json"]
        },
        "POST_config": {
          "component": "Formulaire d’ajout",
          "target_element": "#ai-config-add-modal",
          "view_type": "ModalForm",
          "fields": ["nom", "categorie", "description", "valeur", "flags_protection"]
        },
        "PUT_config": {
          "component": "Formulaire de modification",
          "target_element": "#ai-config-edit-drawer",
          "view_type": "InlineEdit / Drawer",
          "fields": ["valeur", "description"]
        },
        "DELETE_config": {
          "component": "Bouton de suppression",
          "target_element": ".btn-delete-config",
          "view_type": "ConfirmDialog",
          "confirm_message": "Voulez-vous vraiment supprimer cet élément de configuration ?"
        }
      }
    },
    {
      "endpoint": "/api/admin/teams",
      "description": "Gestion modulaire des équipes, des collaborateurs, des rôles RBAC, des permissions et des groupes métiers.",
      "methods": ["GET", "POST", "PUT", "DELETE"],
      "categories": [
        "equipes",
        "membres",
        "roles",
        "permissions",
        "groupes_metiers"
      ],
      "actions": {
        "GET_teams": {
          "method": "GET",
          "action_id": "GET_teams",
          "description": "Récupère l'arborescence des équipes, collaborateurs, rôles et groupes métiers",
          "parameters": {
            "query": {
              "equipe_id": { "type": "string", "required": false }
            }
          },
          "schema": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "equipes": { "type": "array" },
              "membres": { "type": "array" },
              "roles": { "type": "array" },
              "permissions": { "type": "array" },
              "groupes_metiers": { "type": "array" }
            }
          },
          "mock_response": {
            "success": true,
            "equipes": [
              { "id": "eq_audit", "nom": "Pôle Audit & Conformité RSE", "chef": "s.delorme@greenhumble.local", "membres_count": 5 },
              { "id": "eq_sales", "nom": "Pôle Prospection Commerciale", "chef": "m.vasseur@greenhumble.local", "membres_count": 3 }
            ],
            "membres": [
              { "id": "usr_01", "nom": "Sarah Delorme", "email": "s.delorme@greenhumble.local", "role": "Auditeur Senior", "equipe": "Pôle Audit & Conformité RSE", "statut": "actif" },
              { "id": "usr_02", "nom": "Marc Vasseur", "email": "m.vasseur@greenhumble.local", "role": "Commercial B2B", "equipe": "Pôle Prospection Commerciale", "statut": "actif" }
            ],
            "roles": [
              { "id": "role_super_admin", "nom": "Super Administrateur", "niveau": 100, "description": "Accès absolu à l'ensemble du cockpit" },
              { "id": "role_auditeur", "nom": "Auditeur RSE", "niveau": 50, "description": "Gestion des scans, diagnostics et exports" },
              { "id": "role_commercial", "nom": "Commercial", "niveau": 30, "description": "Gestion du pipeline de prospection" }
            ],
            "permissions": [
              { "code": "config:ai:write", "label": "Modifier le moteur IA" },
              { "code": "audit:run", "label": "Lancer un audit RSE" },
              { "code": "teams:admin", "label": "Administrer les équipes" }
            ],
            "groupes_metiers": [
              { "id": "grp_climat", "nom": "Experts Climat & ACV", "specialite": "Bilan Carbone" },
              { "id": "grp_juridique", "nom": "Juristes Green Claims", "specialite": "Loi Climat & CSRD" }
            ]
          },
          "errors": [
            { "code": 401, "message": "Session invalide" },
            { "code": 403, "message": "Accès restreint aux administrateurs" }
          ]
        },
        "POST_teams": {
          "method": "POST",
          "action_id": "POST_teams",
          "description": "Ajoute un nouveau collaborateur ou une nouvelle équipe",
          "parameters": {
            "body": {
              "type": { "type": "string", "enum": ["membre", "equipe"], "required": true },
              "nom": { "type": "string", "required": true },
              "email": { "type": "string", "required": false },
              "role": { "type": "string", "required": false },
              "equipe_id": { "type": "string", "required": false }
            }
          },
          "schema": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" },
              "message": { "type": "string" },
              "membre": { "type": "object" }
            }
          },
          "mock_response": {
            "success": true,
            "message": "Nouveau collaborateur ajouté à l'équipe avec succès",
            "membre": {
              "id": "usr_03",
